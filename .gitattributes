# Shell scripts always check out with LF line endings, so Bash can run them on Windows too.
*.sh text eol=lf

# Library copies must stay byte for byte, because the build checks them against src/lib/sha256sums.txt.
src/lib/** -text
src/lib/** linguist-vendored
*.wasm binary

# Build outputs are stored exactly as the build writes them and are not counted as hand-written code.
dist/** -text
dist/** linguist-generated
